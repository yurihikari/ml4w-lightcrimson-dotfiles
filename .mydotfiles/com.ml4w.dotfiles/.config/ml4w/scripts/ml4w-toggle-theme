#!/usr/bin/env bash
# Toggles between light and dark themes for GTK and ML4W
# Usage: ml4w-toggle-theme [dark|light]

GTK3_SETTINGS_FILE="$HOME/.config/gtk-3.0/settings.ini"
GTK4_SETTINGS_FILE="$HOME/.config/gtk-4.0/settings.ini"
KEY="gtk-application-prefer-dark-theme"
ML4W_DARKMODE_FILE="$HOME/.config/ml4w/settings/darkmode"
CACHE_FILE="$HOME/.cache/ml4w/hyprland-dotfiles/current_wallpaper"

# Ensure the ML4W settings directory exists
mkdir -p "$(dirname "$ML4W_DARKMODE_FILE")"

# Check if GTK3 settings file exists
if [ ! -f "$GTK3_SETTINGS_FILE" ]; then
    echo "Error: $GTK3_SETTINGS_FILE not found."
    exit 1
fi

# The mode to switch to: given ("dark" / "light", e.g. by the GTK settings
# listener), or the opposite of the current one. The current mode is ML4W's
# setting; the GTK preference (1/0 or true/false: GTK settings tools write
# the boolean spelling) when that is missing.
case "$1" in
    dark) current=0 ;;
    light) current=1 ;;
    *)
        current=$(cat "$ML4W_DARKMODE_FILE" 2>/dev/null)
        [ -n "$current" ] || current=$(grep -E "^$KEY=" "$GTK3_SETTINGS_FILE" | awk -F'=' '{print $2}')
        ;;
esac

case "$current" in
    1 | true)
        # Currently dark -> switch to light
        gtk3_value=0
        gtk4_value=false
        darkmode_value=0
        MATUGEN_MODE="light"
        message="Switched to light theme."
        ;;
    *)
        # Currently light, unset or unrecognised -> switch to dark
        gtk3_value=1
        gtk4_value=true
        darkmode_value=1
        MATUGEN_MODE="dark"
        message="Switched to dark theme."
        ;;
esac

# ML4W's mode first: the GTK settings listener compares the files below with
# it, and must see them agree
echo "$darkmode_value" > "$ML4W_DARKMODE_FILE"

# Assign the new value instead of rewriting one specific spelling, so the
# toggle works regardless of how the current value happens to be written.
sed -i "s/^$KEY=.*/$KEY=$gtk3_value/" "$GTK3_SETTINGS_FILE"
if [ -f "$GTK4_SETTINGS_FILE" ]; then
    sed -i "s/^$KEY=.*/$KEY=$gtk4_value/" "$GTK4_SETTINGS_FILE"
fi

echo "$message"

# ==========================================
# Update UI Colors (Matugen & QuickShell)
# ==========================================

# 1. Get the current wallpaper from the cache file (created by your wallpaper script)
if [ -f "$CACHE_FILE" ]; then
    IMAGE_PATH=$(cat "$CACHE_FILE")
else
    echo "Warning: No current wallpaper found at $CACHE_FILE to generate colors."
    exit 1
fi

# A video wallpaper is themed from its first frame (its poster), like
# ml4w-wallpaper does: matugen only reads images.
VIDEO_LIB="$HOME/.config/hypr/conf/custom/video-wallpaper.sh"
if [ -f "$VIDEO_LIB" ]; then
    source "$VIDEO_LIB"
    if vw_is_video "$IMAGE_PATH"; then
        IMAGE_PATH="$(vw_poster "$IMAGE_PATH")" || { echo "Warning: Could not extract a frame from $IMAGE_PATH."; exit 1; }
    fi
fi

# 2. Determine matugen binary path
MATUGEN_BIN="matugen"
if [ -f "$HOME/.cargo/bin/matugen" ]; then
    MATUGEN_BIN="$HOME/.cargo/bin/matugen"
elif [ -f "$HOME/.local/bin/matugen" ]; then
    MATUGEN_BIN="$HOME/.local/bin/matugen"
fi

# 3. Execute matugen with the newly toggled mode
echo "Generating colors with Matugen in $MATUGEN_MODE mode..."
$MATUGEN_BIN image "$IMAGE_PATH" --source-color-index 0 -m "$MATUGEN_MODE"

# 4. Reload Quickshell
echo "Reloading QuickShell..."
qs ipc call theme-manager reload
qs -p $HOME/.local/share/ml4w-dotfiles-settings/quickshell ipc call theme-manager reload

# 5. Reload Waybar so the whole system changes instantly (notifications are
#    drawn by Quickshell and follow its theme reload above)
if pgrep -x "waybar" > /dev/null; then
    pkill -SIGUSR2 waybar
fi

echo "Theme toggle complete!"
