#!/usr/bin/env python3
"""Images attached to a message, ready for Claude: one JSON line per image,
{"path", "media_type", "data"} (base64), in the order given. Big ones are
scaled down with ImageMagick first (to 1568px on the longest side, what
Claude works at anyway), and turned into JPEG if still over ~3.5 MB. An
image that can't be read prints {"path", "error"}."""
import base64
import json
import os
import subprocess
import sys
import tempfile

TYPES = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
         ".gif": "image/gif", ".webp": "image/webp"}
MAX_BYTES = 3_500_000


def prepare(path, tmp):
    ext = os.path.splitext(path)[1].lower()
    media = TYPES.get(ext)
    try:
        size = subprocess.run(["magick", "identify", "-format", "%w %h", path + "[0]"],
                              capture_output=True, text=True, check=True).stdout.split()
        w, h = int(size[0]), int(size[1])
    except (OSError, subprocess.CalledProcessError, ValueError, IndexError):
        w = h = 0
    if media and max(w, h) <= 1568 and os.path.getsize(path) <= MAX_BYTES:
        return media, open(path, "rb").read()
    # Scale down (or convert: BMP, an odd format…)
    out = os.path.join(tmp, "img.png" if media == "image/png" else "img.jpg")
    subprocess.run(["magick", path + "[0]", "-auto-orient", "-resize", "1568x1568>", out], check=True)
    if os.path.getsize(out) > MAX_BYTES and out.endswith(".png"):
        jpg = os.path.join(tmp, "img.jpg")
        subprocess.run(["magick", out, "-quality", "85", jpg], check=True)
        out = jpg
    return ("image/png" if out.endswith(".png") else "image/jpeg"), open(out, "rb").read()


def main():
    with tempfile.TemporaryDirectory() as tmp:
        for path in sys.argv[1:]:
            try:
                media, data = prepare(path, tmp)
                print(json.dumps({"path": path, "media_type": media,
                                  "data": base64.b64encode(data).decode()}), flush=True)
            except (OSError, subprocess.CalledProcessError) as e:
                print(json.dumps({"path": path, "error": str(e)}), flush=True)


if __name__ == "__main__":
    main()
